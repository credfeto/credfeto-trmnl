#!/bin/sh

# Locks the TRMNL host's egress down, like the DNS servers. Called by
# ../update as root.
#
# The rules are one nftables table, inet trm_egress, built and loaded by
# firewall/egress (see there): host_out for what the host itself may connect
# to, docker_fwd for what the bridged containers (Watchtower) may connect to.
# The whole table, address sets included, is replaced in one nft transaction,
# so a refresh never reloads firewalld and a failed load keeps the previous
# rules. firewalld still owns the base zones; larapaper and trmnl-assets use
# host networking, so host_out covers them too. Ingress needs nothing extra
# here: nothing is published through Docker (the app and assets ports are
# host ports, opened by ../update in the public zone only to
# ALLOWED_SOURCES), and SSH is the public zone's own rule set, managed by the
# host's base configuration.
#
# TRMNL_FIREWALL_ENFORCE=true in ../.env is the single enforcement knob:
# unmatched new connections are dropped. Otherwise (the default) they still
# flow and are only logged, with the prefixes "trm-egress-unmatched: " and
# "trm-egress-docker-unmatched: ". The same rules serve both modes: run in
# observation mode, check the log for anything legitimate, then enforce.

set -eu

die() {
    printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    exit 1
}

info() {
    printf '\n\033[32m→\033[0m %s\n' "$*"
}

[ "$(id -u)" -eq 0 ] || die "must run as root"

# One run at a time: trmnl-firewall-sync.timer can fire while ./update (or
# a manual run) is still configuring, and concurrent firewall changes would trip
# over each other.
exec 9> /run/lock/credfeto-trmnl-firewall.lock
flock 9

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
ENV_FILE="${SCRIPT_DIR}/../.env"

env_value() {
    [ -f "${ENV_FILE}" ] || return 0
    grep -E "^[[:space:]]*$1[[:space:]]*=" "${ENV_FILE}" | tail -n 1 | cut -d= -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^"//;s/"$//'
}

ENFORCE="false"
if [ "$(env_value TRMNL_FIREWALL_ENFORCE)" = "true" ]; then
    ENFORCE="true"
fi

# --- Retire the firewalld policies and ipsets an earlier version used. Their
# refresh reloaded firewalld every 10 minutes, and a firewalld killed
# mid-reload (for example by the OOM killer) leaves its block-everything table
# behind. One last reload removes them; after this nothing here reloads
# firewalld.
if command -v firewall-cmd > /dev/null 2>&1 && firewall-cmd --state > /dev/null 2>&1; then
    RETIRED=false
    for POLICY in trm-egress trm-egress-docker; do
        if firewall-cmd --permanent --info-policy="${POLICY}" > /dev/null 2>&1; then
            firewall-cmd --permanent --delete-policy="${POLICY}" > /dev/null || die "Failed to delete policy ${POLICY}"
            RETIRED=true
        fi
    done
    for IPSET in $(firewall-cmd --permanent --get-ipsets); do
        case "${IPSET}" in
            trm-egress-*)
                firewall-cmd --permanent --delete-ipset="${IPSET}" > /dev/null || die "Failed to delete ipset ${IPSET}"
                RETIRED=true
                ;;
        esac
    done
    if [ "${RETIRED}" = "true" ]; then
        info "Removing the old firewalld egress policies..."
        firewall-cmd --reload > /dev/null
    fi
fi
rm -f /usr/local/bin/trmnl-refresh-egress-ipsets

info "Configuring firewall (enforce ${ENFORCE})..."

# --- The egress table and its refresh timer ---
install -m 755 "${SCRIPT_DIR}/egress" /usr/local/bin/trmnl-egress
install -d -m 755 /usr/local/share/credfeto-trmnl
install -m 644 "${SCRIPT_DIR}/github-egress-ranges" /usr/local/share/credfeto-trmnl/github-egress-ranges
install -m 644 "${SCRIPT_DIR}/cloudflare-egress-ranges" /usr/local/share/credfeto-trmnl/cloudflare-egress-ranges
install -m 644 "${SCRIPT_DIR}/trmnl-egress-refresh.service" /etc/systemd/system/trmnl-egress-refresh.service
install -m 644 "${SCRIPT_DIR}/trmnl-egress-refresh.timer" /etc/systemd/system/trmnl-egress-refresh.timer

# --- Keep the firewall in step with the repo (like sync-zones on the DNS
# servers): firewall/sync pulls and re-runs this script when the firewall
# config changes, e.g. the daily egress-ranges commit. A symlink, so the script
# finds the checkout it lives in.
ln -sfn "${SCRIPT_DIR}/sync" /usr/local/sbin/trmnl-firewall-sync
install -m 644 "${SCRIPT_DIR}/trmnl-firewall-sync.service" /etc/systemd/system/trmnl-firewall-sync.service
install -m 644 "${SCRIPT_DIR}/trmnl-firewall-sync.timer" /etc/systemd/system/trmnl-firewall-sync.timer

# The settings firewall/egress reads, written before the timers restart so
# that no run picks up stale ones. Keep the paths in sync with firewall/egress.
install -d -m 755 /var/lib/credfeto-trmnl
printf '%s\n' "${ENFORCE}" > /var/lib/credfeto-trmnl/egress-enforce

systemctl daemon-reload
for UNIT in trmnl-egress-refresh.timer trmnl-firewall-sync.timer; do
    systemctl enable "${UNIT}" > /dev/null 2>&1
    # restart, not just enable --now: an already-active timer keeps its old
    # schedule otherwise.
    systemctl restart "${UNIT}"
done
# Load the table now rather than at the timer's first run.
/usr/local/bin/trmnl-egress

# Record the commit whose firewall config is now live; firewall/sync compares
# against it. Keep the path in sync with firewall/sync.
git -C "${SCRIPT_DIR}" rev-parse HEAD > /var/lib/credfeto-trmnl/firewall-applied-head

info "Firewall configured (enforce ${ENFORCE})."
