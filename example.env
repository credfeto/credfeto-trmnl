# Copy to .env and fill in. Never commit .env.

# Generate with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
# What the device and browsers use, via the Traefik pair. The device's server
# URL must match this exactly (no trailing slash).
APP_URL=https://trmnl.markridgwell.com
FORCE_HTTPS=true
APP_TIMEZONE=Europe/London
# Local mirror of the TRMNL framework assets (filled by ./mirror-assets), via Traefik.
ASSETS_URL=https://trmnl-assets.markridgwell.com
ASSETS_PORT=8081
TRMNL_FRAMEWORK_VERSION=3.4.6
LARAPAPER_TAG=latest
# Container limits for larapaper (chromium leaks; the VM has 4 GB)
LARAPAPER_MEM_LIMIT=1536m
LARAPAPER_PIDS_LIMIT=1024
# Set to 0 once your account exists.
REGISTRATION_ENABLED=1
WATCHTOWER_SCHEDULE=0 47 * * * *

# firewalld: only these sources may reach the app and assets ports (the Traefik hosts).
APP_PORT=8080
ALLOWED_SOURCES=192.168.150.250 192.168.150.251 2a02:8010:61d5:150::250 2a02:8010:61d5:150::251
